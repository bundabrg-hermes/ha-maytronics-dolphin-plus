# Add to an EXISTING ESPHome bluetooth_proxy config.
#
# Easiest: copy dolphin-plus-gatt-addon.yaml next to your YAML and add:
#   packages:
#     maytronics_dolphin_plus: !include dolphin-plus-gatt-addon.yaml
# Then set esp32_ble.max_connections: 5 in your existing esp32_ble block.
#
# SCREEK BP2-POE users: see screek-bp2-poe-dolphin-plus.README.md

# --- OR paste these blocks manually ---

esp32_ble_server:
  max_clients: 2
  services:
    - uuid: "fd5abba0-3935-11e5-85a6-0002a5d5c51b"
      advertise: true
      characteristics:
        - id: dolphin_iot_cmd
          uuid: "fd5abba1-3935-11e5-85a6-0002a5d5c51b"
          notify: true
          read: true
          value:
            data: [0x00]

script:
  - id: dolphin_iot_notify_script
    mode: queued
    parameters:
      payload: int[]
    then:
      - lambda: |-
          std::vector<uint8_t> bytes;
          for (int b : payload) {
            bytes.push_back((uint8_t)(b & 0xFF));
          }
          id(dolphin_iot_cmd)->set_value(bytes);
      - ble_server.characteristic.notify:
          id: dolphin_iot_cmd

